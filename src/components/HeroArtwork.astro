---
// Homepage wordmark: the site name rendered as a shaded ASCII banner at build time and etched
// in by the ASCII runtime. The real name is the (visually hidden) h1; the art is aria-hidden.
// The beta sets the name in Geist Pixel over a dot-matrix field that answers the pointer
// (size it with wordmarkCss() in the page's inlineCss).
import PixelWordmark from "@/components/beta/PixelWordmark.astro";
import RevealText from "@/components/RevealText.astro";
import { site } from "@/config/site";
import { heroBanner } from "@/lib/hero";
import { beta } from "@/lib/variant";

interface Props {
	text?: string;
}

// Sizing CSS for the banner comes from heroBanner().css, emitted by the page into <head>.
const { text = site.name } = Astro.props;
const { art, artCompact } = heroBanner(text);
---

{
	beta ? (
		<section class="hero hero--pixel container" aria-labelledby="hero-name" data-field>
			<canvas class="field-canvas" aria-hidden="true"></canvas>
			<h1 id="hero-name" class="visually-hidden">{text}</h1>
			<RevealText as="p" preset="label" class="hero__eyebrow" text={`> ${site.tagline}`} />
			<div class="hero__frame">
				<PixelWordmark text={text} />
			</div>
			<p class="hero__axis meta" aria-hidden="true">
				<span data-axis>ELSH 001</span><span data-axis-name>square</span>
			</p>
		</section>
	) : (
		<section class="hero container" aria-labelledby="hero-name">
			<h1 id="hero-name" class="visually-hidden">{text}</h1>
			<RevealText as="p" preset="label" class="hero__eyebrow" text={`> ${site.tagline}`} />
			<div class="hero__frame">
				<pre
					class="ascii hero__art hero__art--wide"
					data-ascii="hero-etch"
					data-ascii-pointer
					aria-hidden="true">{art}</pre>
				<pre
					class="ascii hero__art hero__art--compact"
					data-ascii="hero-etch"
					data-ascii-pointer
					aria-hidden="true">{artCompact}</pre>
			</div>
		</section>
	)
}

<style>
	.hero {
		padding-block: var(--space-6) var(--space-6);
		border-bottom: var(--border) solid var(--rule);
	}

	.hero__eyebrow {
		font-family: var(--font-mono);
		font-size: var(--text-micro);
		font-weight: 500;
		letter-spacing: 0.02em;
		text-transform: uppercase;
		color: var(--muted);
		margin-bottom: var(--space-5);
	}

	/* The banner scales to fit its column count exactly: JetBrains Mono advances 0.6em per glyph,
	   so font-size = available width / (cols * 0.6). Capped so short names don't get huge. */
	.hero__frame {
		container: hero / inline-size;
	}

	.hero__art {
		font-size: min(1.5rem, calc(100cqi / (var(--cols) * 0.6)));
		line-height: 1.2;
		width: max-content;
		max-width: 100%;
		overflow: hidden;
		touch-action: pan-y;
	}

	.hero__art--compact {
		display: none;
		font-size: min(1.1rem, calc(100cqi / (var(--cols-compact) * 0.6)));
		line-height: 0.8;
	}
</style>
