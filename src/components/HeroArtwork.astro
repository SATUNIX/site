---
// Homepage wordmark: the site name rendered as a shaded ASCII banner at build time and etched
// in by the ASCII runtime. The real name is the (visually hidden) h1; the art is aria-hidden.
import RevealText from "@/components/RevealText.astro";
import { site } from "@/config/site";
import { columnsOf, renderBanner } from "@/scripts/ascii/font";

interface Props {
	text?: string;
}

const { text = site.name } = Astro.props;
const art = renderBanner(text);
// Narrow screens get a half-width version (one character per pixel) so the name stays legible.
const artCompact = renderBanner(text, { pixelWidth: 1 });
// Swap to the compact banner where the wide one would render below 7px type
// (JetBrains Mono advances 0.6em per glyph). Depends on the name, so it is computed here.
const switchAt = Math.ceil(columnsOf(art) * 0.6 * 7);
// Selectors carry an extra class to outrank Astro's scoped (attribute-qualified) rules.
const switchCss = `@container hero (max-width: ${switchAt}px) {
	.hero__frame .hero__art.hero__art--wide { display: none; }
	.hero__frame .hero__art.hero__art--compact { display: block; }
}`;
---

<section class="hero container" aria-labelledby="hero-name">
	<h1 id="hero-name" class="visually-hidden">{text}</h1>
	<RevealText as="p" preset="label" class="hero__eyebrow" text={`> ${site.tagline}`} />
	<div
		class="hero__frame"
		style={`--cols: ${columnsOf(art)}; --cols-compact: ${columnsOf(artCompact)}`}
	>
		<pre
			class="ascii hero__art hero__art--wide"
			data-ascii="hero-etch"
			data-ascii-pointer
			aria-hidden="true">{art}</pre>
		<pre
			class="ascii hero__art hero__art--compact"
			data-ascii="hero-etch"
			data-ascii-pointer
			aria-hidden="true">{artCompact}</pre>
	</div>
	<style is:inline set:html={switchCss}></style>
</section>

<style>
	.hero {
		padding-block: var(--space-4) var(--space-5);
	}

	.hero__eyebrow {
		font-family: var(--font-mono);
		font-size: var(--step--1);
		color: var(--color-fg-muted);
		margin-bottom: var(--space-3);
	}

	/* The banner scales to fit its column count exactly: JetBrains Mono advances 0.6em per glyph,
	   so font-size = available width / (cols * 0.6). Capped so short names don't get huge. */
	.hero__frame {
		container: hero / inline-size;
	}

	.hero__art {
		font-size: min(1.5rem, calc(100cqi / (var(--cols) * 0.6)));
		line-height: 1.2;
		width: max-content;
		max-width: 100%;
		overflow: hidden;
		touch-action: pan-y;
	}

	.hero__art--compact {
		display: none;
		font-size: min(1.1rem, calc(100cqi / (var(--cols-compact) * 0.6)));
		line-height: 0.8;
	}
</style>
