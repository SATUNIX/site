---
// Footer: feed link, motion toggle on animated pages, and an explicit unconfigured notice.
import { site } from "@/config/site";
import { path } from "@/lib/url";

interface Props {
	motionToggle?: boolean;
}

const { motionToggle = false } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="container site-footer__inner">
		<p>(c) {year} {site.author}</p>
		<a href={path(site.links.rss)}>rss</a>
		{
			motionToggle && (
				<button class="text-button" type="button" data-motion-toggle aria-pressed="false">
					[ motion: <span data-motion-label>on</span> ]
				</button>
			)
		}
		{!site.isConfigured && <p class="unconfigured">site config: placeholder values</p>}
	</div>
</footer>
