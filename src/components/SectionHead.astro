---
// Numbered section heading: a mono index label ("01 / writing") over a large sans heading.
// Both type in on scroll; the label carries the retro index, the heading stays readable.
import RevealText from "@/components/RevealText.astro";

interface Props {
	index?: string;
	label: string;
	title: string;
	id?: string;
}

const { index, label, title, id } = Astro.props;
---

<header class="section-head">
	<RevealText as="p" preset="label" class="section-head__label" text={index ? `${index} / ${label}` : label} />
	<RevealText as="h2" preset="title" class="section-head__title" text={title} id={id} />
</header>

<style>
	.section-head {
		position: sticky;
		top: var(--space-4);
	}

	.section-head__label {
		font-family: var(--font-mono);
		font-size: var(--text-micro);
		font-weight: 500;
		letter-spacing: 0.02em;
		text-transform: uppercase;
		color: var(--muted);
		margin-bottom: var(--space-3);
	}

	.section-head__title {
		font-size: var(--text-section);
		line-height: 0.98;
		letter-spacing: -0.035em;
		overflow-wrap: anywhere;
	}

	@media (max-width: 56.25rem) {
		.section-head {
			position: static;
			margin-bottom: var(--space-5);
		}
	}
</style>
