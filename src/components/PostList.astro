---
// Posts as rows: date, title, description. Titles and dates type in on scroll.
import RevealText from "@/components/RevealText.astro";
import type { BlogPost } from "@/lib/posts";
import { path } from "@/lib/url";

interface Props {
	posts: BlogPost[];
	emptyLabel?: string;
}

const { posts, emptyLabel = "No posts yet." } = Astro.props;
const iso = (d: Date) => d.toISOString().slice(0, 10);
---

{
	posts.length === 0 ? (
		<p class="muted mono">{emptyLabel}</p>
	) : (
		<ol class="post-list" role="list">
			{posts.map((post) => (
				<li class="post-list__item">
					<RevealText
						as="time"
						preset="meta"
						class="post-list__date meta"
						datetime={post.data.pubDate.toISOString()}
						text={iso(post.data.pubDate)}
					/>
					<div class="post-list__body">
						<h3 class="post-list__title">
							<a href={path(`blog/${post.id}/`)}>
								<RevealText text={post.data.title} preset="title" />
							</a>
						</h3>
						{post.data.draft ? (
							<p class="post-list__draft meta">[ draft: dev preview only ]</p>
						) : (
							post.data.wip && <p class="post-list__draft meta">[ draft: work in progress ]</p>
						)}
						<p class="post-list__desc muted">{post.data.description}</p>
					</div>
				</li>
			))}
		</ol>
	)
}

<style>
	.post-list {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.post-list__item {
		display: grid;
		grid-template-columns: 11ch 1fr;
		gap: var(--space-1) var(--space-3);
		padding-block: var(--space-2);
	}

	.post-list__date {
		padding-top: 0.35em;
	}

	.post-list__title {
		font-size: var(--step-2);
		line-height: 1.15;
	}

	.post-list__title a {
		color: var(--color-fg);
	}

	.post-list__title a:hover {
		color: var(--color-accent);
		text-decoration: none;
	}

	.post-list__draft {
		color: var(--color-accent);
		margin-top: 0.25em;
	}

	.post-list__desc {
		margin-top: var(--space-1);
		max-width: var(--measure);
	}

	@media (max-width: 40rem) {
		.post-list__item {
			grid-template-columns: 1fr;
		}
	}
</style>
