---
// Posts as rows: date, title, description. Titles and dates type in on scroll.
import RevealText from "@/components/RevealText.astro";
import type { BlogPost } from "@/lib/posts";
import { path } from "@/lib/url";

interface Props {
	posts: BlogPost[];
	emptyLabel?: string;
}

const { posts, emptyLabel = "No posts yet." } = Astro.props;
const iso = (d: Date) => d.toISOString().slice(0, 10);
---

{
	posts.length === 0 ? (
		<p class="muted mono">{emptyLabel}</p>
	) : (
		<ol class="post-list" role="list">
			{posts.map((post) => (
				<li class="post-list__item">
					<RevealText
						as="time"
						preset="meta"
						class="post-list__date meta"
						datetime={post.data.pubDate.toISOString()}
						text={iso(post.data.pubDate)}
					/>
					<div class="post-list__body">
						<h3 class="post-list__title">
							<a href={path(`blog/${post.id}/`)}>
								<RevealText text={post.data.title} preset="title" />
							</a>
						</h3>
						{post.data.draft ? (
							<p class="post-list__draft meta">Draft: dev preview only</p>
						) : (
							post.data.wip && <p class="post-list__draft meta">Draft: work in progress</p>
						)}
						<RevealText as="p" preset="copy" class="post-list__desc muted" text={post.data.description} />
					</div>
				</li>
			))}
		</ol>
	)
}

<style>
	.post-list {
		list-style: none;
		margin: 0;
		padding: 0;
		border-top: var(--border) solid var(--rule);
	}

	/* Rows: hairline dividers, and the whole row inverts to the accent on hover. */
	.post-list__item {
		display: grid;
		grid-template-columns: 11ch 1fr;
		gap: var(--space-2) var(--space-4);
		padding: var(--space-4) var(--space-3);
		border-bottom: var(--hairline) solid var(--hair);
	}

	.post-list__item:hover {
		background: var(--accent);
		color: var(--on-accent);
	}

	.post-list__item:hover .meta,
	.post-list__item:hover .post-list__desc {
		color: var(--on-accent);
	}

	.post-list__date {
		padding-top: 0.5em;
	}

	.post-list__title {
		font-size: var(--text-h1);
		line-height: 1.1;
		letter-spacing: -0.03em;
	}

	.post-list__title a {
		color: inherit;
		text-decoration: none;
	}

	.post-list__title a:hover {
		background: transparent;
		text-decoration: underline;
		text-decoration-thickness: var(--border);
		text-underline-offset: 0.15em;
	}

	.post-list__draft {
		margin-top: var(--space-1);
	}

	.post-list__desc {
		margin-top: var(--space-2);
		max-width: var(--measure);
		font-size: var(--text-small);
	}

	.post-list__item:hover :focus-visible {
		outline-color: var(--on-accent);
	}

	@media (max-width: 40rem) {
		.post-list__item {
			grid-template-columns: 1fr;
		}
	}
</style>
