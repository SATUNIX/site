---
// Numbered entries: mono index + status on the left, title, summary and a compact
// "covers" list on the right. Used by /work/ and /projects/.
import RevealText from "@/components/RevealText.astro";

export interface Entry {
	title: string;
	tagline?: string;
	status?: string;
	summary: string;
	items: string[];
	href?: string;
}

interface Props {
	entries: Entry[];
	/** Label for the item list, e.g. "covers" or "themes". */
	itemsLabel: string;
}

const { entries, itemsLabel } = Astro.props;
const pad = (n: number) => String(n).padStart(2, "0");
---

<ol class="entries" role="list">
	{
		entries.map((entry, i) => (
			<li class="entry">
				<p class="entry__index meta">
					<RevealText preset="meta" text={pad(i + 1)} />
					{entry.status && <span class="entry__status">{entry.status}</span>}
				</p>
				<div class="entry__body">
					<h2 class="entry__title">
						<RevealText preset="title" text={entry.title} />
					</h2>
					{entry.tagline && (
						<RevealText as="p" preset="label" class="entry__tagline mono" text={entry.tagline} />
					)}
					<RevealText as="p" preset="copy" class="entry__summary" text={entry.summary} />
					<p class="entry__items meta">
						<span class="entry__items-label">{itemsLabel}:</span>{" "}
						<RevealText preset="copy" text={entry.items.join(" / ")} />
					</p>
					{entry.href && (
						<p class="entry__link mono">
							<a href={entry.href} rel="noopener">
								{entry.href.replace(/^https?:\/\//, "")}
							</a>
						</p>
					)}
				</div>
			</li>
		))
	}
</ol>

<style>
	.entries {
		list-style: none;
		margin: 0;
		padding: 0;
		border-top: var(--border) solid var(--rule);
	}

	.entry {
		display: grid;
		grid-template-columns: 11ch 1fr;
		gap: var(--space-2) var(--space-4);
		padding: var(--space-5) 0;
		border-bottom: var(--border) solid var(--rule);
	}

	.entry__index {
		display: flex;
		flex-direction: column;
		gap: var(--space-1);
		padding-top: 0.5em;
	}

	.entry__status {
		color: var(--fg);
	}

	.entry__body {
		max-width: var(--measure);
	}

	.entry__title {
		font-size: var(--text-h1);
		line-height: 1.1;
	}

	.entry__tagline {
		margin-top: var(--space-2);
		font-size: var(--text-micro);
		font-weight: 500;
		letter-spacing: 0.02em;
		text-transform: uppercase;
		color: var(--muted);
	}

	.entry__summary {
		margin-top: var(--space-3);
		line-height: 1.6;
	}

	.entry__items {
		margin-top: var(--space-3);
		font-family: var(--font-sans);
		font-size: var(--text-small);
		font-weight: 400;
		letter-spacing: 0;
		text-transform: none;
		line-height: 1.6;
	}

	.entry__items-label {
		font-family: var(--font-mono);
		font-size: var(--text-micro);
		font-weight: 600;
		letter-spacing: 0.02em;
		text-transform: uppercase;
		color: var(--fg);
	}

	.entry__link {
		margin-top: var(--space-2);
		font-size: var(--text-small);
		overflow-wrap: anywhere;
	}

	@media (max-width: 40rem) {
		.entry {
			grid-template-columns: 1fr;
		}

		.entry__index {
			flex-direction: row;
			gap: var(--space-3);
			padding-top: 0;
		}
	}
</style>
