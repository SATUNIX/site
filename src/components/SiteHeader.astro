---
// Site name and primary navigation. Plain anchors; the current page is marked for AT and style.
// The beta adds a "beta" tag and a shell opener (hidden until the runtime is ready).
import { site } from "@/config/site";
import { path } from "@/lib/url";
import { beta } from "@/lib/variant";

const nav = [
	{ href: path("blog/"), label: "writing", match: "blog/" },
	{ href: path("work/"), label: "work", match: "work/" },
	{ href: path("projects/"), label: "projects", match: "projects/" },
	{ href: path("cv/"), label: "cv", match: "cv/" },
	{ href: path("links/"), label: "links", match: "links/" },
];
const here = Astro.url.pathname;
---

<header class="site-header">
	<div class="container site-header__inner">
		<a class="site-header__name" href={path("/")}
			>{site.name}{beta && <span class="site-header__tag">beta</span>}</a
		>
		<nav class="site-nav" aria-label="Primary">
			{
				nav.map((item) => (
					<a href={item.href} aria-current={here.includes(item.match) ? "page" : undefined}>
						{item.label}
					</a>
				))
			}
			{
				beta && (
					<button
						class="site-nav__shell"
						type="button"
						data-shell-open
						aria-haspopup="dialog"
						aria-keyshortcuts="/"
						hidden
					>
						<kbd aria-hidden="true">/</kbd><span class="site-nav__label">shell</span>
					</button>
				)
			}
		</nav>
	</div>
</header>
