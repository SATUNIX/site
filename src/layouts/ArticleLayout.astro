---
// Long-form reading layout. Deliberately static: no animation runtime on article pages.
import BaseLayout from "@/layouts/BaseLayout.astro";
import { path } from "@/lib/url";

interface Props {
	title: string;
	description: string;
	pubDate: Date;
	updatedDate?: Date;
	tags?: string[];
	backHref?: string;
}

const { title, description, pubDate, updatedDate, tags = [], backHref = path("blog/") } =
	Astro.props;
const iso = (d: Date) => d.toISOString().slice(0, 10);
---

<BaseLayout title={title} description={description}>
	<article class="container article">
		<header class="article__head">
			<p class="meta">
				<time datetime={pubDate.toISOString()}>{iso(pubDate)}</time>
				{
					updatedDate && (
						<>
							{" "}/ updated <time datetime={updatedDate.toISOString()}>{iso(updatedDate)}</time>
						</>
					)
				}
				{tags.length > 0 && <span> / {tags.join(", ")}</span>}
			</p>
			<h1 class="article__title">{title}</h1>
			<p class="article__dek muted">{description}</p>
		</header>
		<div class="prose">
			<slot />
		</div>
		<p class="article__back mono"><a href={backHref}>cd ../writing</a></p>
	</article>
</BaseLayout>

<style>
	.article {
		padding-block: var(--space-4) var(--space-5);
	}

	.article__head {
		max-width: var(--measure);
		margin-bottom: var(--space-4);
	}

	.article__title {
		font-size: var(--step-3);
		margin-top: var(--space-2);
	}

	.article__dek {
		font-size: var(--step-1);
		line-height: 1.4;
		margin-top: var(--space-2);
	}

	.article__back {
		margin-top: var(--space-5);
		font-size: var(--step--1);
	}
</style>
