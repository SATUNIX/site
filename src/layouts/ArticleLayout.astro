---
// Long-form reading layout. Deliberately static: no animation runtime on article pages.
import BaseLayout from "@/layouts/BaseLayout.astro";
import { path } from "@/lib/url";

interface Props {
	title: string;
	description: string;
	pubDate: Date;
	updatedDate?: Date;
	tags?: string[];
	backHref?: string;
	/** Published work in progress: labelled on the page and kept out of search indexes. */
	wip?: boolean;
}

const {
	title,
	description,
	pubDate,
	updatedDate,
	tags = [],
	backHref = path("blog/"),
	wip = false,
} = Astro.props;
const iso = (d: Date) => d.toISOString().slice(0, 10);
---

<BaseLayout title={wip ? `Draft: ${title}` : title} description={description} noindex={wip}>
	<article class="container article">
		{
			wip && (
				<p class="article__wip mono" role="note">
					Draft. Work in progress: an outline with working notes. The finished post will
					replace it.
				</p>
			)
		}
		<header class="article__head">
			<p class="meta">
				<time datetime={pubDate.toISOString()}>{iso(pubDate)}</time>
				{
					updatedDate && (
						<>
							{" "}/ updated <time datetime={updatedDate.toISOString()}>{iso(updatedDate)}</time>
						</>
					)
				}
				{tags.length > 0 && <span> / {tags.join(", ")}</span>}
			</p>
			<h1 class="article__title">{title}</h1>
			<p class="article__dek muted">{description}</p>
		</header>
		<div class="prose">
			<slot />
		</div>
		<p class="article__back mono"><a href={backHref}>cd ../writing</a></p>
	</article>
</BaseLayout>

<style>
	.article {
		padding-block: var(--space-6) var(--space-7);
	}

	/* Draft notice: a ruled callout, words first. */
	.article__wip {
		max-width: var(--measure);
		margin-bottom: var(--space-5);
		padding: var(--space-3) var(--space-4);
		background: var(--surface);
		border: var(--border) solid var(--rule);
		font-size: var(--text-micro);
		font-weight: 500;
		letter-spacing: 0.02em;
		text-transform: uppercase;
		line-height: 1.7;
	}

	.article__head {
		max-width: calc(var(--measure) + 12ch);
		margin-bottom: var(--space-6);
		padding-bottom: var(--space-5);
		border-bottom: var(--border) solid var(--rule);
	}

	.article__title {
		font-size: var(--text-section);
		margin-top: var(--space-3);
		overflow-wrap: anywhere;
	}

	.article__dek {
		font-size: var(--text-h2);
		line-height: 1.4;
		margin-top: var(--space-4);
		max-width: var(--measure);
	}

	.article__back {
		margin-top: var(--space-7);
		font-size: var(--text-small);
	}

	@media print {
		.article {
			padding-block: 1rem;
		}
	}
</style>
