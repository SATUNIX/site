---
// Page shell: meta, global styles, motion state, header and footer.
// `animated` pages load the ASCII runtime; article and CV pages leave it off and ship no JS.
import "@/styles/base.css";
import "@/styles/layout.css";
import "@/styles/prose.css";
import "@/styles/ascii.css";
import "@/styles/print.css";

import AsciiRuntime from "@/components/AsciiRuntime.astro";
import MotionState from "@/components/MotionState.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import { site } from "@/config/site";
import { inlineStyle } from "@/lib/csp";
import { markdownPath } from "@/lib/markdown";
import { absolute, asset, basePath, path } from "@/lib/url";

interface Props {
	title?: string;
	description?: string;
	/** Site-relative path of this page for the canonical URL, e.g. "blog/". */
	canonical?: string;
	noindex?: boolean;
	animated?: boolean;
	bodyClass?: string;
	/** Advertise this page's Markdown twin (/<page>.md). Off for pages without one (404). */
	markdown?: boolean;
	/** Page-specific CSS computed at build time; emitted in <head> and hashed into the CSP. */
	inlineCss?: string;
}

const {
	title,
	description = site.description,
	canonical,
	noindex = false,
	animated = false,
	bodyClass = "",
	markdown = true,
	inlineCss,
} = Astro.props;

const fullTitle = title ? `${title} | ${site.name}` : site.name;
const pathname = Astro.url.pathname;
const canonicalPath =
	canonical ??
	(basePath() && pathname.startsWith(basePath()) ? pathname.slice(basePath().length) : pathname);
---

<!doctype html>
<html lang="en" data-motion="off">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="color-scheme" content="dark" />
		<meta name="theme-color" content="#161616" />
		<meta name="referrer" content="strict-origin-when-cross-origin" />
		<title>{fullTitle}</title>
		<meta name="description" content={description} />
		<meta name="author" content={site.author} />
		<link rel="canonical" href={absolute(canonicalPath)} />
		{noindex && <meta name="robots" content="noindex" />}
		<link rel="icon" href={asset("favicon.svg")} type="image/svg+xml" />
		<link rel="alternate" type="application/rss+xml" title={site.name} href={path(site.links.rss)} />
		{markdown && <link rel="alternate" type="text/markdown" href={path(markdownPath(canonicalPath))} />}
		<link rel="help" type="text/plain" href={path("llms.txt")} title="llms.txt" />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={absolute(canonicalPath)} />
		<meta property="og:site_name" content={site.name} />
		{animated && <MotionState />}
		{inlineCss && <style is:inline set:html={inlineStyle(Astro, inlineCss)} />}
	</head>
	<body class={bodyClass}>
		<a class="skip-link" href="#main">Skip to content</a>
		<div class="page">
			<SiteHeader />
			<main id="main" class="page__main">
				<slot />
			</main>
			<SiteFooter motionToggle={animated} />
		</div>
		{animated && <AsciiRuntime />}
	</body>
</html>
