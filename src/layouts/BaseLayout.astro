---
// Page shell: meta, global styles, motion state, header and footer.
// `animated` pages load the ASCII runtime; article and CV pages leave it off and ship no JS.
// In the beta build every page also loads the Geist Pixel layer (styles, shell, runtime), is
// noindexed, and points its canonical URL at the matching stable page.
import "@/styles/base.css";
import "@/styles/layout.css";
import "@/styles/prose.css";
import "@/styles/ascii.css";
import "@/styles/print.css";

import AsciiRuntime from "@/components/AsciiRuntime.astro";
import PixelHead from "@/components/beta/PixelHead.astro";
import PixelRuntime from "@/components/beta/PixelRuntime.astro";
import PixelShell from "@/components/beta/PixelShell.astro";
import MotionState from "@/components/MotionState.astro";
import SiteFooter from "@/components/SiteFooter.astro";
import SiteHeader from "@/components/SiteHeader.astro";
import { site } from "@/config/site";
import { inlineStyle } from "@/lib/csp";
import { markdownPath } from "@/lib/markdown";
import { absolute, asset, path, sitePath, stableUrl } from "@/lib/url";
import { beta } from "@/lib/variant";

interface Props {
	title?: string;
	description?: string;
	/** Site-relative path of this page for the canonical URL, e.g. "blog/". */
	canonical?: string;
	noindex?: boolean;
	animated?: boolean;
	bodyClass?: string;
	/** Advertise this page's Markdown twin (/<page>.md). Off for pages without one (404). */
	markdown?: boolean;
	/** Page-specific CSS computed at build time; emitted in <head> and hashed into the CSP. */
	inlineCss?: string;
}

const {
	title,
	description = site.description,
	canonical,
	noindex = false,
	animated = false,
	bodyClass = "",
	markdown = true,
	inlineCss,
} = Astro.props;

const fullTitle = title ? `${title} | ${site.name}` : site.name;
const pathname = Astro.url.pathname;
const canonicalPath = canonical ?? sitePath(pathname);
// The beta is a preview of the stable pages: credit them, and keep the beta out of indexes.
const canonicalUrl = beta ? stableUrl(canonicalPath) : absolute(canonicalPath);
const robotsNoindex = noindex || beta;
// The 404 page is served for any missing path, so its stable twin is the homepage.
const stableHere = canonicalPath.replace(/^\/+/, "") === "404/" ? "/" : canonicalPath;
---

<!doctype html>
<html lang="en" data-motion="off" class={beta ? "beta" : undefined}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="color-scheme" content="light dark" />
		<meta name="theme-color" content="#ecece9" media="(prefers-color-scheme: light)" />
		<meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
		<meta name="referrer" content="strict-origin-when-cross-origin" />
		<title>{fullTitle}</title>
		<meta name="description" content={description} />
		<meta name="author" content={site.author} />
		<link rel="canonical" href={canonicalUrl} />
		{robotsNoindex && <meta name="robots" content="noindex" />}
		<link rel="icon" href={asset("favicon.svg")} type="image/svg+xml" />
		<link rel="alternate" type="application/rss+xml" title={site.name} href={path(site.links.rss)} />
		{markdown && <link rel="alternate" type="text/markdown" href={path(markdownPath(canonicalPath))} />}
		<link rel="help" type="text/plain" href={path("llms.txt")} title="llms.txt" />
		<meta property="og:title" content={fullTitle} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:url" content={canonicalUrl} />
		<meta property="og:site_name" content={site.name} />
		{animated && <MotionState />}
		{inlineCss && <style is:inline set:html={inlineStyle(Astro, inlineCss)} />}
		{beta && <PixelHead />}
	</head>
	<body class={bodyClass}>
		<a class="skip-link" href="#main">Skip to content</a>
		<div class="page">
			<SiteHeader />
			<main id="main" class="page__main">
				<slot />
			</main>
			<SiteFooter motionToggle={animated} here={stableHere} />
		</div>
		{beta && <PixelShell />}
		{animated && <AsciiRuntime />}
		{beta && <PixelRuntime />}
	</body>
</html>
