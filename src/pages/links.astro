---
// External profiles and the OpenPGP key. Links that are not set are simply not listed.
import RevealText from "@/components/RevealText.astro";
import SectionHead from "@/components/SectionHead.astro";
import { site } from "@/config/site";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { fingerprint, formatFingerprint, isPgpConfigured } from "@/lib/pgp";
import { asset, path } from "@/lib/url";

// Only links that exist are listed; a `null` in site config leaves that row off entirely.
const entries = [
	{ key: "github", href: site.links.github },
	{ key: "linkedin", href: site.links.linkedin },
	{ key: "gravatar", href: site.links.gravatar },
	{ key: "contact", href: site.links.contact },
	{ key: "rss", href: path(site.links.rss) },
].filter((entry): entry is { key: string; href: string } => entry.href !== null);
const display = (href: string) => href.replace(/^mailto:/, "").replace(/^https?:\/\//, "");
const pgp = isPgpConfigured() && fingerprint.fingerprint ? fingerprint : null;
---

<BaseLayout title="Links" description={`Where to find ${site.name}.`} animated>
	<section class="container section section--wide section--split">
		<SectionHead label="ls links/" title="Links" />
		<dl class="links">
			{
				entries.map((entry) => (
					<div class="links__row">
						<dt class="meta">{entry.key}</dt>
						<dd>
							<a href={entry.href} rel={entry.href.startsWith("http") ? "me noopener" : undefined}>
								<RevealText preset="label" text={display(entry.href)} />
							</a>
						</dd>
					</div>
				))
			}
		</dl>
	</section>

	<section class="container section section--split" aria-labelledby="pgp">
		<SectionHead label="gpg --fingerprint" title="OpenPGP key" id="pgp" />
		{
			pgp && pgp.fingerprint ? (
				<div class="pgp">
					<p class="pgp__fpr mono">
						<RevealText preset="meta" text={formatFingerprint(pgp.fingerprint)} />
					</p>
					<p class="mono">
						<a href={asset(pgp.keyPath ?? "keys/public.asc")} download>
							download public.asc
						</a>
					</p>
				</div>
			) : (
				<p class="unconfigured">
					No public key published yet. Put it at public/keys/public.asc; the fingerprint is
					derived from the key at build time.
				</p>
			)
		}
	</section>
</BaseLayout>

<style>
	.links {
		margin: 0;
		border-top: var(--border) solid var(--rule);
	}

	.links__row {
		display: grid;
		grid-template-columns: 11ch 1fr;
		gap: var(--space-4);
		align-items: baseline;
		padding: var(--space-3);
		border-bottom: var(--hairline) solid var(--hair);
	}

	.links__row:hover {
		background: var(--accent);
		color: var(--on-accent);
	}

	.links__row:hover :focus-visible {
		outline-color: var(--on-accent);
	}

	.links__row:hover .meta {
		color: var(--on-accent);
	}

	.links dd {
		margin: 0;
		font-size: var(--text-h2);
		font-weight: 600;
		letter-spacing: -0.02em;
		overflow-wrap: anywhere;
	}

	.links dd a {
		color: inherit;
	}

	.links dd a:hover {
		background: transparent;
		text-decoration: underline;
		text-decoration-thickness: var(--border);
	}

	.pgp {
		padding: var(--space-4);
		border: var(--border) solid var(--rule);
		background: var(--surface);
	}

	.pgp__fpr {
		font-size: var(--text-h2);
		letter-spacing: 0.02em;
		max-width: 30ch;
		margin-bottom: var(--space-3);
		overflow-wrap: anywhere;
	}

	@media (max-width: 40rem) {
		.links__row {
			grid-template-columns: 1fr;
			gap: 0;
		}
	}
</style>
