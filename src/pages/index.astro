---
import HeroArtwork from "@/components/HeroArtwork.astro";
import PostList from "@/components/PostList.astro";
import RevealText from "@/components/RevealText.astro";
import SectionHead from "@/components/SectionHead.astro";
import { profile } from "@/data/profile";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { getPublishedPosts } from "@/lib/posts";
import { path } from "@/lib/url";

const recent = (await getPublishedPosts()).slice(0, 3);
const keyWidth = Math.max(...profile.facts.map((f) => f.key.length));
const areas = [
	{
		name: "Offensive Security",
		text: "Penetration testing and adversary simulation across networks, Active Directory, cloud and APIs.",
		href: path("work/"),
	},
	{
		name: "Security Engineering",
		text: "The infrastructure behind the testing: C2, telemetry pipelines, GitOps, tooling and platforms.",
		href: path("work/"),
	},
	{
		name: "AI Systems",
		text: "Securing autonomous agents, and building constrained agent systems in a private lab.",
		href: path("projects/"),
	},
];
const routes = [
	{ cmd: "ls work/", href: path("work/"), note: "representative engagement types" },
	{ cmd: "ls lab/", href: path("projects/"), note: "personal research and experiments" },
	{ cmd: "cd writing/", href: path("blog/"), note: "notes, essays and write-ups" },
	{ cmd: "cat cv.txt", href: path("cv/"), note: "roles, capabilities, certifications" },
	{ cmd: "ls links/", href: path("links/"), note: "GitHub, Gravatar and feed" },
];
---

<BaseLayout animated canonical="/">
	<HeroArtwork />

	<section class="container section about" aria-labelledby="about">
		<SectionHead index="01" label="about" title="Hello." id="about" />
		<div class="about__grid">
			<div class="about__intro prose">
				{
					profile.intro.length > 0 ? (
						profile.intro.map((para) => <p>{para}</p>)
					) : (
						<p class="unconfigured">
							Intro not written yet: add paragraphs to src/data/profile.ts.
						</p>
					)
				}
			</div>
			<dl class="readout" aria-label="Key information">
				{
					profile.facts.map((fact) => (
						<div class="readout__row">
							<dt>{fact.key.padEnd(keyWidth, " ")}</dt>
							<dd>
								{fact.value ? (
									<RevealText preset="label" text={fact.value} />
								) : (
									<span class="readout__unset">unset</span>
								)}
							</dd>
						</div>
					))
				}
			</dl>
		</div>
	</section>

	<section class="container section" aria-labelledby="areas">
		<SectionHead index="02" label="scope" title="Security. Systems. Software." id="areas" />
		<ol class="areas" role="list">
			{
				areas.map((area, i) => (
					<li class="area">
						<p class="meta">{`0${i + 1}`}</p>
						<h3 class="area__name">
							<a href={area.href}>
								<RevealText preset="title" text={area.name} />
							</a>
						</h3>
						<p class="area__text muted">{area.text}</p>
					</li>
				))
			}
		</ol>
	</section>

	<section class="container section" aria-labelledby="writing">
		<SectionHead index="03" label="writing" title="Recent writing" id="writing" />
		<PostList posts={recent} emptyLabel="First posts are in draft. Check back soon." />
		<p class="more mono"><a href={path("blog/")}>ls writing/ --all</a></p>
	</section>

	<section class="container section section--wide" aria-labelledby="elsewhere">
		<SectionHead index="04" label="index" title="Find your way around" id="elsewhere" />
		<ul class="routes" role="list">
			{
				routes.map((r) => (
					<li>
						<a href={r.href}>
							<span class="routes__prompt" aria-hidden="true">$ </span>
							<RevealText preset="label" text={r.cmd} />
						</a>
						<span class="routes__note muted">{r.note}</span>
					</li>
				))
			}
		</ul>
	</section>
</BaseLayout>

<style>
	.about__grid {
		display: grid;
		grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
		gap: var(--space-4);
		align-items: start;
	}

	.areas {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
		gap: var(--space-4) var(--space-3);
	}

	.area__name {
		font-size: var(--step-2);
		margin-block: var(--space-1);
	}

	.area__name a {
		color: var(--color-fg);
	}

	.area__name a:hover {
		color: var(--color-accent);
		text-decoration: none;
	}

	.area__text {
		line-height: 1.6;
	}

	.readout {
		margin: 0;
		font-family: var(--font-mono);
		font-size: var(--step--1);
		font-variant-ligatures: none;
	}

	.readout__row {
		display: flex;
		gap: 2ch;
		padding-block: 0.2em;
	}

	.readout dt {
		white-space: pre;
		color: var(--color-fg-muted);
	}

	.readout dt::after {
		content: " :";
	}

	.readout dd {
		margin: 0;
		color: var(--color-fg);
	}

	.readout__unset {
		color: var(--color-fg-muted);
		opacity: 0.6;
	}

	.more {
		margin-top: var(--space-3);
		font-size: var(--step--1);
	}

	.routes {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: var(--space-3);
	}

	.routes li {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		gap: var(--space-1) var(--space-3);
	}

	.routes a {
		font-family: var(--font-mono);
		font-size: var(--step-2);
		font-variant-ligatures: none;
	}

	.routes__prompt {
		color: var(--color-fg-muted);
	}

	.routes__note {
		font-size: var(--step--1);
		font-family: var(--font-mono);
	}

	@media (max-width: 48rem) {
		.about__grid {
			grid-template-columns: 1fr;
		}

		.routes a {
			font-size: var(--step-1);
		}
	}
</style>
