---
import HeroArtwork from "@/components/HeroArtwork.astro";
import PostList from "@/components/PostList.astro";
import RevealText from "@/components/RevealText.astro";
import SectionHead from "@/components/SectionHead.astro";
import { site } from "@/config/site";
import { profile } from "@/data/profile";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { heroBanner } from "@/lib/hero";
import { getPublishedPosts } from "@/lib/posts";
import { path } from "@/lib/url";

const recent = (await getPublishedPosts()).slice(0, 3);
const areas = profile.areas.map((area) => ({ ...area, href: path(area.page) }));
const routes = [
	{ cmd: "ls work/", href: path("work/"), note: "representative engagement types" },
	{ cmd: "ls lab/", href: path("projects/"), note: "personal research and experiments" },
	{ cmd: "cd writing/", href: path("blog/"), note: "notes, essays and write-ups" },
	{ cmd: "cat cv.txt", href: path("cv/"), note: "roles, capabilities, certifications" },
	{ cmd: "ls links/", href: path("links/"), note: "GitHub, Gravatar and feed" },
];
---

<BaseLayout animated canonical="/" inlineCss={heroBanner(site.name).css}>
	<HeroArtwork />

	<section class="container section section--split about" aria-labelledby="about">
		<SectionHead index="01" label="about" title="Hello." id="about" />
		<div class="about__grid">
			<div class="about__intro prose">
				{
					profile.intro.length > 0 ? (
						profile.intro.map((para) => <RevealText as="p" preset="copy" text={para} />)
					) : (
						<p class="unconfigured">
							Intro not written yet: add paragraphs to src/data/profile.ts.
						</p>
					)
				}
			</div>
			<dl class="readout" aria-label="Key information">
				{
					profile.facts.map((fact) => (
						<div class="readout__row">
							<dt>{fact.key}</dt>
							<dd>
								{fact.value ? (
									<RevealText preset="label" text={fact.value} />
								) : (
									<span class="readout__unset">unset</span>
								)}
							</dd>
						</div>
					))
				}
			</dl>
		</div>
	</section>

	<section class="container section section--split" aria-labelledby="areas">
		<SectionHead index="02" label="scope" title="Security. Systems. Software." id="areas" />
		<ol class="areas" role="list">
			{
				areas.map((area, i) => (
					<li class="area">
						<p class="meta">{`0${i + 1}`}</p>
						<h3 class="area__name">
							<a href={area.href}>
								<RevealText preset="title" text={area.name} />
							</a>
						</h3>
						<RevealText as="p" preset="copy" class="area__text muted" text={area.text} />
					</li>
				))
			}
		</ol>
	</section>

	<section class="container section section--split" aria-labelledby="writing">
		<SectionHead index="03" label="writing" title="Recent writing" id="writing" />
		<PostList posts={recent} emptyLabel="First posts are in draft. Check back soon." />
		<p class="more mono"><a href={path("blog/")}>ls writing/ --all</a></p>
	</section>

	<section class="container section section--wide section--split" aria-labelledby="elsewhere">
		<SectionHead index="04" label="index" title="Find your way around" id="elsewhere" />
		<ul class="routes" role="list">
			{
				routes.map((r) => (
					<li>
						<a href={r.href}>
							<span class="routes__prompt" aria-hidden="true">$ </span>
							<RevealText preset="label" text={r.cmd} />
						</a>
						<RevealText preset="label" class="routes__note muted" text={r.note} />
					</li>
				))
			}
		</ul>
	</section>
</BaseLayout>

<style>
	.about__grid {
		display: grid;
		grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
		gap: var(--space-5);
		align-items: start;
	}

	/* Scope: three ruled tiles that invert to the accent on hover. */
	.areas {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(3, minmax(0, 1fr));
		border: var(--border) solid var(--rule);
	}

	.area {
		padding: var(--space-4);
		background: var(--surface);
		border-right: var(--border) solid var(--rule);
	}

	.area:last-child {
		border-right: 0;
	}

	.area:hover {
		background: var(--accent);
		color: var(--on-accent);
	}

	.area:hover .meta,
	.area:hover .area__text {
		color: var(--on-accent);
	}

	.area__name {
		font-size: var(--text-h1);
		margin-block: var(--space-3);
	}

	.area__name a {
		color: inherit;
		text-decoration: none;
	}

	.area__name a:hover {
		background: transparent;
		text-decoration: underline;
		text-decoration-thickness: var(--border);
		text-underline-offset: 0.15em;
	}

	.area__text {
		font-size: var(--text-small);
		line-height: 1.6;
	}

	/* Key information: a ruled readout, label left, value right. */
	.readout {
		margin: 0;
		border: var(--border) solid var(--rule);
		background: var(--surface);
	}

	.readout__row {
		display: grid;
		grid-template-columns: 11ch 1fr;
		gap: var(--space-3);
		padding: var(--space-3);
		border-top: var(--hairline) solid var(--hair);
	}

	.readout__row:first-child {
		border-top: 0;
	}

	.readout dt {
		white-space: normal;
		font-family: var(--font-mono);
		font-size: var(--text-micro);
		font-weight: 500;
		letter-spacing: 0.02em;
		text-transform: uppercase;
		color: var(--muted);
		padding-top: 0.2em;
	}

	.readout dd {
		margin: 0;
		font-size: var(--text-small);
		overflow-wrap: anywhere;
	}

	.readout__unset {
		color: var(--muted);
	}

	.more {
		margin-top: var(--space-4);
		font-size: var(--text-small);
	}

	/* Index: rows divided by hairlines; hover inverts the whole row. */
	.routes {
		list-style: none;
		margin: 0;
		padding: 0;
		border-top: var(--border) solid var(--rule);
	}

	.routes li {
		display: flex;
		flex-wrap: wrap;
		align-items: baseline;
		justify-content: space-between;
		gap: var(--space-2) var(--space-4);
		padding: var(--space-3);
		border-bottom: var(--hairline) solid var(--hair);
	}

	.routes li:hover {
		background: var(--accent);
		color: var(--on-accent);
	}

	.routes li:hover .routes__note,
	.routes li:hover .routes__prompt {
		color: var(--on-accent);
	}

	.routes a {
		font-family: var(--font-mono);
		font-size: var(--text-h2);
		font-weight: 500;
		color: inherit;
		text-decoration: none;
	}

	.routes a:hover {
		background: transparent;
		text-decoration: underline;
		text-decoration-thickness: var(--border);
		text-underline-offset: 0.2em;
	}

	.routes__prompt {
		color: var(--muted);
	}

	.routes__note {
		font-size: var(--text-micro);
		font-weight: 500;
		letter-spacing: 0.02em;
		text-transform: uppercase;
		font-family: var(--font-mono);
	}

	/* The body column is narrow beside the head column; stack the tiles before they crowd. */
	@media (max-width: 70rem) {
		.areas {
			grid-template-columns: minmax(0, 1fr);
		}

		.area {
			border-right: 0;
			border-bottom: var(--border) solid var(--rule);
		}

		.area:last-child {
			border-bottom: 0;
		}
	}

	@media (max-width: 56.25rem) {
		.about__grid {
			grid-template-columns: 1fr;
		}
	}

	@media (max-width: 48rem) {
		.routes a {
			font-size: var(--text-body);
		}
	}

	/* The focus ring is lime in the dark theme: on a lime hover surface it must flip to black. */
	.area:hover :focus-visible,
	.routes li:hover :focus-visible {
		outline-color: var(--on-accent);
	}
</style>
