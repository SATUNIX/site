---
// Public CV. Text types in on scroll like the rest of the site; print.css disables the
// animated layer so the browser's print dialog still produces a clean one-colour PDF.
import RevealText from "@/components/RevealText.astro";
import { site } from "@/config/site";
import { cv } from "@/data/cv";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="CV" description={`Curriculum vitae of ${site.name}.`} animated>
	<article class="container cv">
		<header class="cv__head">
			<RevealText as="p" preset="label" class="meta" text="cat cv.txt" />
			<RevealText as="h1" preset="title" class="cv__name" text={site.name} />
			{
				cv.summary ? (
					<RevealText as="p" preset="copy" class="cv__summary" text={cv.summary} />
				) : (
					<p class="unconfigured">Summary not written yet: edit src/data/cv.ts.</p>
				)
			}
			{cv.note && <RevealText as="p" preset="label" class="cv__note meta" text={cv.note} />}
		</header>

		<section class="cv__section" aria-labelledby="cv-exp">
			<RevealText as="h2" preset="label" id="cv-exp" class="cv__label" text="Experience" />
			{
				cv.experience.length === 0 ? (
					<p class="unconfigured">No roles added yet.</p>
				) : (
					<ol class="cv__list" role="list">
						{cv.experience.map((role) => (
							<li class="cv__item">
								<RevealText as="p" preset="meta" class="meta cv__period" text={role.period} />
								<div>
									<h3 class="cv__role">
										<RevealText preset="title" text={role.org ? `${role.title} / ${role.org}` : role.title} />
									</h3>
									{role.points.length > 0 && (
										<ul class="cv__points">
											{role.points.map((p) => (
												<li>
													<RevealText preset="copy" text={p} />
												</li>
											))}
										</ul>
									)}
								</div>
							</li>
						))}
					</ol>
				)
			}
		</section>

		<section class="cv__section" aria-labelledby="cv-cap">
			<RevealText as="h2" preset="label" id="cv-cap" class="cv__label" text="Capabilities" />
			<ul class="cv__caps">
				{
					cv.capabilities.map((c) => (
						<li>
							<RevealText preset="copy" text={c} />
						</li>
					))
				}
			</ul>
		</section>

		<section class="cv__section" aria-labelledby="cv-qual">
			<RevealText as="h2" preset="label" id="cv-qual" class="cv__label" text="Credentials" />
			{
				cv.qualifications.length === 0 ? (
					<p class="unconfigured">No credentials added yet.</p>
				) : (
					<ol class="cv__list" role="list">
						{cv.qualifications.map((q) => (
							<li class="cv__item">
								<RevealText as="p" preset="meta" class="meta cv__period" text={q.status} />
								<RevealText as="h3" preset="title" class="cv__role" text={q.name} />
							</li>
						))}
					</ol>
				)
			}
		</section>

		<section class="cv__section" aria-labelledby="cv-skills">
			<RevealText as="h2" preset="label" id="cv-skills" class="cv__label" text="Skills" />
			{
				cv.skills.length === 0 ? (
					<p class="unconfigured">No skills added yet.</p>
				) : (
					<dl class="cv__skills">
						{cv.skills.map((group) => (
							<div>
								<dt class="meta">
									<RevealText preset="label" text={group.label} />
								</dt>
								<dd>
									<RevealText preset="copy" text={group.items.join(", ")} />
								</dd>
							</div>
						))}
					</dl>
				)
			}
		</section>
	</article>
</BaseLayout>

<style>
	.cv {
		padding-block: var(--space-4) var(--space-5);
		max-width: calc(var(--measure) + 14ch + 2 * var(--gutter));
	}

	.cv__name {
		font-size: var(--step-4);
		overflow-wrap: anywhere;
		margin-block: var(--space-2) var(--space-3);
	}

	.cv__summary {
		font-size: var(--step-1);
		line-height: 1.5;
		max-width: var(--measure);
	}

	.cv__note {
		margin-top: var(--space-2);
	}

	.cv__section {
		margin-top: var(--space-5);
	}

	.cv__caps {
		margin: 0;
		padding-left: 1.25em;
		columns: 2 22rem;
		column-gap: var(--space-4);
	}

	.cv__caps li {
		break-inside: avoid;
		padding-block: 0.2em;
	}

	.cv__label {
		font-family: var(--font-mono);
		font-size: var(--step--1);
		font-weight: 400;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--color-fg-muted);
		margin-bottom: var(--space-3);
	}

	.cv__list {
		list-style: none;
		margin: 0;
		padding: 0;
	}

	.cv__item {
		display: grid;
		grid-template-columns: 18ch 1fr;
		gap: var(--space-1) var(--space-3);
		padding-block: var(--space-2);
		break-inside: avoid;
	}

	.cv__period {
		padding-top: 0.3em;
	}

	.cv__role {
		font-size: var(--step-1);
	}

	.cv__points {
		margin-top: var(--space-1);
		padding-left: 1.25em;
		max-width: var(--measure);
	}

	.cv__skills {
		display: grid;
		gap: var(--space-2);
		margin: 0;
	}

	.cv__skills dd {
		margin: 0;
	}

	@media (max-width: 40rem) {
		.cv__item {
			grid-template-columns: 1fr;
		}

		.cv__summary {
			font-size: var(--step-0);
		}
	}

	@media print {
		.cv__name {
			font-size: 24pt;
		}

		.cv__section {
			margin-top: 1.5rem;
		}
	}
</style>
