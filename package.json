{
  "name": "site",
  "version": "1.0.0",
  "description": "Personal site and CV: static Astro build with animated ASCII type, deployed to GitHub Pages.",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "author": "Tony (https://github.com/SATUNIX)",
  "homepage": "https://satunix.github.io/site/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SATUNIX/site.git"
  },
  "bugs": {
    "url": "https://github.com/SATUNIX/site/issues"
  },
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "node scripts/derive-fingerprint.mjs && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "check:site": "node scripts/check-site.mjs",
    "test": "vitest run",
    "verify": "npm run check && npm run test && npm run build && npm run check:site"
  },
  "engines": {
    "node": ">=22.11.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-satteri": "^0.4.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.4",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  }
}
